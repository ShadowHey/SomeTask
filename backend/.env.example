# Copy this file to .env and provide values through your local secret manager.
APP_NAME=Audio Notes Platform
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/audio_notes
REDIS_URL=redis://localhost:6379

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=audio-files

GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_MODEL=gnani-prisma-v2.5
GNANI_POLL_INTERVAL_SECONDS=30
GNANI_DEFAULT_LANGUAGE_CODE=hi-IN,en-IN

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
